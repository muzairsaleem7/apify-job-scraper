# Apify API token(s): Apify Console -> Settings -> API & Integrations.
# Put one or more, comma-separated. They are tried in order; if one is invalid,
# out of credit, or hits its usage limit, the scraper switches to the next.
APIFY_TOKENS=apify_api_xxxxxxxxxxxxxxxx,apify_api_yyyyyyyyyyyyyyyy

# Google Sheets export for the web UI (npm start). Optional; see SETUP.md -> "Google Sheets".
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (type: Desktop app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
